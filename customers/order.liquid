<section style="padding:44px 0 80px">
  <div class="wrap" style="max-width:800px">
    <div class="yk-breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><a href="{{ routes.account_url }}">Account</a><span>/</span><span style="font-weight:700;color:var(--ink)">{{ order.name }}</span></div>
    <h1 style="font-size:clamp(34px,4.4vw,54px);margin-bottom:10px">Order {{ order.name }}</h1>
    <p style="color:rgba(23,87,45,.65);margin:0 0 30px">Placed on {{ order.created_at | date: "%d %B %Y" }} · {{ order.fulfillment_status_label }}</p>

    <div style="border:1px solid rgba(23,87,45,.1);border-radius:20px;overflow:hidden;margin-bottom:26px">
      {%- for line in order.line_items -%}
        <div style="display:flex;gap:16px;align-items:center;padding:16px 20px;border-bottom:1px solid rgba(23,87,45,.08)">
          {%- if line.image -%}<img src="{{ line.image | image_url: width: 120 }}" alt="" style="width:56px;height:70px;object-fit:cover;border-radius:8px">{%- endif -%}
          <div style="flex:1"><div style="font-weight:700">{{ line.title }}</div><div style="font-size:13px;color:rgba(23,87,45,.6)">Qty {{ line.quantity }}</div></div>
          <div style="font-weight:700">{{ line.final_line_price | money }}</div>
        </div>
      {%- endfor -%}
      <div style="display:flex;justify-content:space-between;padding:16px 20px;background:var(--cream);font-weight:700">
        <span>Total</span><span>{{ order.total_price | money }}</span>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px" class="yk-grid-2">
      <div><h3 style="font-size:16px;margin-bottom:8px">Shipping address</h3><p style="font-size:14px;color:rgba(23,87,45,.7);line-height:1.6">{{ order.shipping_address | format_address }}</p></div>
      <div><h3 style="font-size:16px;margin-bottom:8px">Billing address</h3><p style="font-size:14px;color:rgba(23,87,45,.7);line-height:1.6">{{ order.billing_address | format_address }}</p></div>
    </div>
  </div>
</section>
