<section style="padding:44px 0 80px">
  <div class="wrap" style="max-width:700px">
    <div class="yk-breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><a href="{{ routes.account_url }}">Account</a><span>/</span><span style="font-weight:700;color:var(--ink)">Addresses</span></div>
    <h1 style="font-size:clamp(34px,4.4vw,54px);margin-bottom:26px">Your addresses</h1>

    {%- for address in customer.addresses -%}
      <div style="border:1px solid rgba(23,87,45,.1);border-radius:16px;padding:20px;margin-bottom:14px">
        <p style="font-size:14.5px;line-height:1.6;color:rgba(23,87,45,.8);margin:0 0 12px">{{ address | format_address }}</p>
        <div style="display:flex;gap:8px">
          <a href="{{ routes.account_addresses_url }}/{{ address.id }}/edit" class="btn btn-outline btn-sm">Edit</a>
          {%- form 'customer_address', address -%}
            <input type="hidden" name="_method" value="delete">
            <button type="submit" class="btn btn-outline btn-sm">Delete</button>
          {%- endform -%}
        </div>
      </div>
    {%- endfor -%}

    <h2 style="font-size:22px;margin:30px 0 16px">Add a new address</h2>
    {%- form 'customer_address', customer.new_address -%}
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px" class="yk-grid-2">
        <input type="text" name="address[first_name]" placeholder="First name" style="border:1.5px solid rgba(23,87,45,.16);border-radius:12px;padding:13px 16px">
        <input type="text" name="address[last_name]" placeholder="Last name" style="border:1.5px solid rgba(23,87,45,.16);border-radius:12px;padding:13px 16px">
        <input type="text" name="address[address1]" placeholder="Address" style="grid-column:span 2;border:1.5px solid rgba(23,87,45,.16);border-radius:12px;padding:13px 16px">
        <input type="text" name="address[city]" placeholder="City" style="border:1.5px solid rgba(23,87,45,.16);border-radius:12px;padding:13px 16px">
        <input type="text" name="address[zip]" placeholder="Pincode" style="border:1.5px solid rgba(23,87,45,.16);border-radius:12px;padding:13px 16px">
        <input type="text" name="address[phone]" placeholder="Phone" style="grid-column:span 2;border:1.5px solid rgba(23,87,45,.16);border-radius:12px;padding:13px 16px">
      </div>
      <button type="submit" class="btn btn-primary" style="margin-top:16px">Save address</button>
    {%- endform -%}
  </div>
</section>
