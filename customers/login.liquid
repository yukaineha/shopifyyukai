<section style="padding:64px 0;display:flex;justify-content:center">
  <div style="width:100%;max-width:440px;padding:0 20px">
    <div style="display:flex;gap:4px;background:var(--cream);border-radius:999px;padding:5px;margin-bottom:34px">
      <span class="btn btn-sm" style="flex:1;background:var(--g);color:#fff;cursor:default">Sign in</span>
      <a href="{{ routes.account_register_url }}" class="btn btn-sm btn-outline" style="flex:1;text-align:center;border:none">Create account</a>
    </div>

    <h1 style="font-size:clamp(34px,3.6vw,50px);margin-bottom:8px">Welcome back</h1>
    <div class="yk-kicker" style="color:var(--o);margin-bottom:30px">Your shelf, remembered</div>

    {%- form 'customer_login' -%}
      {%- if form.errors -%}
        <div style="background:rgba(224,97,38,.08);color:var(--o);border-radius:12px;padding:14px 16px;margin-bottom:16px;font-size:14px">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div style="display:flex;flex-direction:column;gap:14px">
        <div>
          <label style="display:block;font-size:11.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(23,87,45,.6);margin-bottom:7px">Email</label>
          <input type="email" name="customer[email]" autocomplete="email" required style="width:100%;border:1.5px solid rgba(23,87,45,.16);border-radius:13px;padding:15px 16px;font-size:15px;color:var(--ink);outline:none">
        </div>
        {%- if form.password_needed -%}
        <div>
          <label style="display:block;font-size:11.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(23,87,45,.6);margin-bottom:7px">Password</label>
          <input type="password" name="customer[password]" autocomplete="current-password" required style="width:100%;border:1.5px solid rgba(23,87,45,.16);border-radius:13px;padding:15px 16px;font-size:15px;color:var(--ink);outline:none">
        </div>
        {%- endif -%}
      </div>
      <div style="display:flex;justify-content:flex-end;margin-top:12px">
        <a href="{{ routes.account_recover_url }}" style="font-size:13.5px;font-weight:600;color:var(--o)">Forgot password?</a>
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;margin-top:20px">Sign in</button>
    {%- endform -%}

    <p style="font-size:12.5px;line-height:1.6;color:rgba(23,87,45,.55);margin:22px 0 0;text-align:center">
      By continuing you agree to our <a href="{{ pages.terms.url | default: '#' }}" style="text-decoration:underline">terms</a>.
    </p>
  </div>
</section>
