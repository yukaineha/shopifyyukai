<section style="padding:64px 0;display:flex;justify-content:center">
  <div style="width:100%;max-width:440px;padding:0 20px">
    <div style="display:flex;gap:4px;background:var(--cream);border-radius:999px;padding:5px;margin-bottom:34px">
      <a href="{{ routes.account_login_url }}" class="btn btn-sm btn-outline" style="flex:1;text-align:center;border:none">Sign in</a>
      <span class="btn btn-sm" style="flex:1;background:var(--g);color:#fff;cursor:default">Create account</span>
    </div>

    <h1 style="font-size:clamp(34px,3.6vw,50px);margin-bottom:8px">Join YUKAI</h1>
    <div class="yk-kicker" style="color:var(--o);margin-bottom:30px">10% off your first jar</div>

    {%- form 'create_customer' -%}
      {%- if form.errors -%}
        <div style="background:rgba(224,97,38,.08);color:var(--o);border-radius:12px;padding:14px 16px;margin-bottom:16px;font-size:14px">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px">
        <div><label style="display:block;font-size:11.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(23,87,45,.6);margin-bottom:7px">First name</label>
          <input type="text" name="customer[first_name]" style="width:100%;border:1.5px solid rgba(23,87,45,.16);border-radius:13px;padding:15px 16px;font-size:15px;color:var(--ink);outline:none"></div>
        <div><label style="display:block;font-size:11.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(23,87,45,.6);margin-bottom:7px">Last name</label>
          <input type="text" name="customer[last_name]" style="width:100%;border:1.5px solid rgba(23,87,45,.16);border-radius:13px;padding:15px 16px;font-size:15px;color:var(--ink);outline:none"></div>
        <div style="grid-column:span 2"><label style="display:block;font-size:11.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(23,87,45,.6);margin-bottom:7px">Email</label>
          <input type="email" name="customer[email]" autocomplete="email" required style="width:100%;border:1.5px solid rgba(23,87,45,.16);border-radius:13px;padding:15px 16px;font-size:15px;color:var(--ink);outline:none"></div>
        <div style="grid-column:span 2"><label style="display:block;font-size:11.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(23,87,45,.6);margin-bottom:7px">Password</label>
          <input type="password" name="customer[password]" autocomplete="new-password" required style="width:100%;border:1.5px solid rgba(23,87,45,.16);border-radius:13px;padding:15px 16px;font-size:15px;color:var(--ink);outline:none"></div>
      </div>
      <label style="display:flex;align-items:flex-start;gap:10px;cursor:pointer;font-size:13.5px;color:rgba(23,87,45,.75);line-height:1.5;margin-top:16px">
        <input type="checkbox" name="customer[accepts_marketing]" style="width:17px;height:17px;accent-color:var(--g);cursor:pointer;margin-top:2px;flex:none">
        <span>Send me new flavours and festive boxes. One email a fortnight, never more.</span>
      </label>
      <button type="submit" class="btn btn-primary" style="width:100%;margin-top:20px">Create account</button>
    {%- endform -%}
  </div>
</section>
