<section style="padding:64px 0;display:flex;justify-content:center">
  <div style="width:100%;max-width:440px;padding:0 20px">
    <h1 style="font-size:clamp(30px,3.4vw,44px);margin-bottom:8px">Set a new password</h1>
    <p style="color:rgba(23,87,45,.65);margin:0 0 26px">for {{ email }}</p>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<div style="background:rgba(224,97,38,.08);color:var(--o);border-radius:12px;padding:14px 16px;margin-bottom:16px;font-size:14px">{{ form.errors | default_errors }}</div>{%- endif -%}
      <input type="password" name="customer[password]" placeholder="New password" required style="width:100%;margin-bottom:12px;border:1.5px solid rgba(23,87,45,.16);border-radius:13px;padding:15px 16px">
      <input type="password" name="customer[password_confirmation]" placeholder="Confirm password" required style="width:100%;margin-bottom:16px;border:1.5px solid rgba(23,87,45,.16);border-radius:13px;padding:15px 16px">
      <button type="submit" class="btn btn-primary" style="width:100%">Reset password</button>
    {%- endform -%}
  </div>
</section>
