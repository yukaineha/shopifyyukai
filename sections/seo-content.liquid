<section style="background:var(--cream);padding:96px 0">
  <div class="wrap yk-grid-2" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.82fr);gap:56px;align-items:center">
    <div>
      <div class="rv yk-kicker" style="color:var(--p)">{{ section.settings.kicker }}</div>
      <h2 class="rv" style="font-size:clamp(32px,4vw,58px);margin:4px 0 24px">{{ section.settings.heading }}</h2>
      {%- for block in section.blocks -%}
        {%- if block.type == 'paragraph' -%}
          <p class="rv" style="font-size:16.5px;line-height:1.75;color:rgba(23,87,45,.8);margin:0 0 17px;max-width:560px">{{ block.settings.text }}</p>
        {%- endif -%}
      {%- endfor -%}
      <div class="rv" style="display:flex;flex-wrap:wrap;gap:26px;margin-top:30px;padding-top:26px;border-top:1px solid rgba(23,87,45,.14)">
        {%- for block in section.blocks -%}
          {%- if block.type == 'fact' -%}
            <div>
              <div style="font-family:var(--font-heading);font-weight:800;font-size:28px;line-height:1;color:{{ block.settings.color }}">{{ block.settings.n }}</div>
              <div style="font-size:12.5px;color:rgba(23,87,45,.65);margin-top:5px">{{ block.settings.label }}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    <div class="rv" style="position:relative;border-radius:26px;overflow:hidden;aspect-ratio:4/5;background:#fff">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block">
      {%- else -%}
        <img src="{{ 'seo-trio.jpg' | asset_url }}" alt="YUKAI jars of roasted makhana, cashews and muesli" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block">
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SEO content block",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "What we make, plainly" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Healthy roasted snacks online, made in four ranges" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "blocks": [
    { "type": "paragraph", "name": "Paragraph", "settings": [{ "type": "textarea", "id": "text", "label": "Text" }] },
    { "type": "fact", "name": "Fact", "settings": [
      { "type": "text", "id": "n", "label": "Number" },
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "color", "id": "color", "label": "Color", "default": "#663988" }
    ]}
  ],
  "default": {
    "blocks": [
      { "type": "paragraph", "settings": { "text": "YUKAI is a healthy snacks brand making roasted Indian snacks in four ranges. Roasted makhana and BBQ corn sit under Mil Baith Ke, veg chips and dehydrated fruits under Poshan Ka Pitara, flavoured cashews and almonds under Mehmaan Nawazi, and protein edamame, millet snacks and muesli under Sehat Ki Baatein." } },
      { "type": "paragraph", "settings": { "text": "Pack sizes run from 30 g travel sachets to 150 g jars and 500 g refill pouches, so the same flavour works as an office snack, a tiffin snack for kids, a gym bag high protein snack or a festive gift." } },
      { "type": "fact", "settings": { "n": "4", "label": "ranges", "color": "#663988" } },
      { "type": "fact", "settings": { "n": "17", "label": "flavours in production", "color": "#19B1C1" } },
      { "type": "fact", "settings": { "n": "30 g to 500 g", "label": "pack sizes", "color": "#E06126" } }
    ]
  },
  "presets": [{ "name": "SEO content block" }]
}
{% endschema %}
