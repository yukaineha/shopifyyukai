<section style="padding:44px 0 20px">
  <div class="wrap">
    <div class="yk-breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><span style="font-weight:700;color:var(--ink)">Help centre</span></div>
    <div class="yk-kicker" style="color:var(--p)">We're here to help</div>
    <h1 style="font-size:clamp(38px,5vw,64px);margin:4px 0 10px">Help centre</h1>
    <p style="font-size:16px;color:rgba(23,87,45,.7);max-width:560px;margin:0">Track an order, check our return policy, or write to us directly.</p>
  </div>
</section>

<section style="padding:30px 0 60px;border-bottom:1px solid rgba(23,87,45,.1)">
  <div class="wrap yk-grid-2" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:26px">
    <div style="border:1px solid rgba(23,87,45,.12);border-radius:22px;padding:32px">
      <h2 style="font-size:24px;margin-bottom:6px">Track your order</h2>
      <p style="font-size:14px;color:rgba(23,87,45,.65);margin:0 0 20px">Enter your order number and the email or phone used at checkout.</p>
      <form action="{{ routes.account_login_url }}" method="get" style="display:flex;flex-direction:column;gap:12px">
        <input name="order" placeholder="Order number, e.g. #1234" style="border:1.5px solid rgba(23,87,45,.16);border-radius:12px;padding:13px 16px;font-size:14.5px;outline:none">
        <input name="contact" placeholder="Email or phone" style="border:1.5px solid rgba(23,87,45,.16);border-radius:12px;padding:13px 16px;font-size:14.5px;outline:none">
        <button type="submit" class="btn btn-primary">Sign in to track</button>
      </form>
      <p style="font-size:12.5px;color:rgba(23,87,45,.55);margin:10px 0 0">Order tracking lives in your account — sign in to see live status.</p>
    </div>

    <div style="border:1px solid rgba(23,87,45,.12);border-radius:22px;padding:32px">
      <h2 style="font-size:24px;margin-bottom:6px">Contact us</h2>
      <p style="font-size:14px;color:rgba(23,87,45,.65);margin:0 0 20px">We reply within one business day.</p>
      {%- form 'contact' -%}
        {%- if form.posted_successfully? -%}
          <div style="font-size:14.5px;color:var(--g);background:rgba(23,87,45,.08);border-radius:12px;padding:16px">Thanks — your message is in. We'll get back to you soon.</div>
        {%- else -%}
          <div style="display:flex;flex-direction:column;gap:12px">
            <input type="text" name="contact[name]" placeholder="Your name" style="border:1.5px solid rgba(23,87,45,.16);border-radius:12px;padding:13px 16px;font-size:14.5px;outline:none">
            <input type="email" name="contact[email]" required placeholder="Email" style="border:1.5px solid rgba(23,87,45,.16);border-radius:12px;padding:13px 16px;font-size:14.5px;outline:none">
            <textarea name="contact[body]" required placeholder="How can we help?" rows="3" style="border:1.5px solid rgba(23,87,45,.16);border-radius:12px;padding:13px 16px;font-size:14.5px;outline:none;resize:vertical"></textarea>
            <button type="submit" class="btn btn-primary">Send message</button>
          </div>
        {%- endif -%}
      {%- endform -%}
      <div style="margin-top:18px;padding-top:16px;border-top:1px solid rgba(23,87,45,.1);font-size:13.5px;color:rgba(23,87,45,.65);line-height:1.7">
        {{ section.settings.support_email }} · {{ section.settings.support_phone }}<br>{{ section.settings.support_hours }}
      </div>
    </div>
  </div>
</section>

<section style="padding:60px 0">
  <div class="wrap yk-grid-2" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px">
    <div style="border-radius:20px;padding:26px;background:rgba(224,97,38,.05)">
      <h3 style="font-size:19px;margin-bottom:10px;color:var(--o)">Returns & refunds</h3>
      <div style="font-size:14px;line-height:1.6;color:rgba(23,87,45,.78)">· 7-day returns on unopened jars<br>· Instant replacement for damaged orders<br>· Refunds processed in 5–7 business days<br>· <a href="{{ pages.returns.url | default: '#' }}" style="text-decoration:underline">Full policy</a></div>
    </div>
    <div style="border-radius:20px;padding:26px;background:rgba(102,57,136,.05)">
      <h3 style="font-size:19px;margin-bottom:10px;color:var(--p)">Payment</h3>
      <div style="font-size:14px;line-height:1.6;color:rgba(23,87,45,.78)">· UPI, cards, net banking<br>· Cash on delivery available<br>· GST invoice on every order</div>
    </div>
  </div>
</section>

<section style="padding:0 0 80px">
  <div class="wrap" style="max-width:820px">
    <h2 style="font-size:clamp(28px,3.2vw,42px);margin-bottom:20px;text-align:center">Frequently asked</h2>
    <div data-acc-group>
      {%- for block in section.blocks -%}
        <div class="yk-acc-item">
          <button type="button" class="yk-acc-btn" data-acc-toggle>
            <span style="font-size:16px;font-weight:600;color:var(--ink)">{{ block.settings.question }}</span>
            <span class="yk-acc-plus">+</span>
          </button>
          <div class="yk-acc-panel"><p>{{ block.settings.answer }}</p></div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Help centre",
  "settings": [
    { "type": "text", "id": "support_email", "label": "Support email", "default": "support@yukaifoodroots.com" },
    { "type": "text", "id": "support_phone", "label": "Support phone", "default": "+91 98765 43210" },
    { "type": "text", "id": "support_hours", "label": "Support hours", "default": "Mon–Sat, 10am–6pm IST" }
  ],
  "blocks": [
    { "type": "faq", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "textarea", "id": "answer", "label": "Answer" }
    ]}
  ],
  "default": {
    "blocks": [
      { "type": "faq", "settings": { "question": "How do I track my order?", "answer": "Sign in to your account to see live order status and tracking updates by SMS and email once the order ships." } },
      { "type": "faq", "settings": { "question": "Do you offer cash on delivery?", "answer": "Yes, COD is available on most pin codes alongside UPI, cards and net banking." } },
      { "type": "faq", "settings": { "question": "What is your return policy?", "answer": "Unopened jars in original packaging can be returned within 7 days of delivery. See our full return and refund policy for details." } },
      { "type": "faq", "settings": { "question": "What if my order arrives damaged?", "answer": "Write to us within 48 hours of delivery with a photo of the damage and your order number, and we will replace it at no cost." } },
      { "type": "faq", "settings": { "question": "Do you ship pan India?", "answer": "Yes, we deliver across India. A small number of remote pin codes may take a few extra days." } }
    ]
  },
  "presets": [{ "name": "Help centre" }]
}
{% endschema %}
