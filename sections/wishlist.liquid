<section style="padding:40px 0 80px">
  <div class="wrap">
    <div class="yk-breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><span style="font-weight:700;color:var(--ink)">Wishlist</span></div>
    <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap;margin-bottom:30px">
      <div>
        <div class="yk-kicker" style="color:var(--p)">Saved for later, or for someone else</div>
        <h1 style="font-size:clamp(40px,5vw,74px);margin-top:4px">Your wishlist</h1>
      </div>
      <div id="yk-wish-actions" style="display:none;gap:9px;flex-wrap:wrap">
        <button type="button" id="yk-wish-addall" class="btn btn-primary">Add all to cart</button>
      </div>
    </div>

    <div id="yk-wish-empty" style="border:1.5px dashed rgba(23,87,45,.2);border-radius:24px;padding:80px 34px;text-align:center;display:none">
      <div style="width:64px;height:64px;border-radius:50%;background:var(--cream);display:flex;align-items:center;justify-content:center;margin:0 auto 20px">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="var(--o)" stroke-width="1.8" stroke-linecap="round"><path d="M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4z"></path></svg>
      </div>
      <h2 style="font-size:34px;margin-bottom:12px">Nothing saved yet</h2>
      <p style="font-size:16px;color:rgba(23,87,45,.65);margin:0 auto 26px;max-width:400px">Tap the heart on any jar and it waits here until you are ready.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary">Browse flavours</a>
    </div>

    <div id="yk-wish-grid" style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px" class="yk-grid-4"></div>
  </div>
</section>

<script>
(function () {
  var grid = document.getElementById('yk-wish-grid');
  var empty = document.getElementById('yk-wish-empty');
  var actions = document.getElementById('yk-wish-actions');

  function moneyFmt(cents) { return '₹' + Math.round(cents / 100).toLocaleString('en-IN'); }

  function render() {
    var handles = (window.YukaiWishlist && window.YukaiWishlist.get()) || [];
    grid.innerHTML = '';
    if (!handles.length) {
      empty.style.display = 'block';
      actions.style.display = 'none';
      return;
    }
    empty.style.display = 'none';
    actions.style.display = 'flex';
    handles.forEach(function (handle) {
      fetch('/products/' + handle + '.js').then(function (r) { return r.ok ? r.json() : null; }).then(function (p) {
        if (!p) return;
        var variant = p.variants[0];
        var card = document.createElement('article');
        card.className = 'yk-card';
        card.innerHTML =
          '<a href="' + p.url + '" class="yk-card__media">' +
            (p.featured_image ? '<img src="' + p.featured_image + '" alt="' + p.title.replace(/"/g, '&quot;') + '" loading="lazy">' : '') +
          '</a>' +
          '<button type="button" class="yk-card__wish is-active" data-wish-toggle="' + handle + '" title="Remove from wishlist">' +
            '<svg width="17" height="17" viewBox="0 0 24 24" fill="#E06126" stroke="#E06126" stroke-width="1.6" stroke-linecap="round"><path d="M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4z"></path></svg>' +
          '</button>' +
          '<div class="yk-card__body">' +
            '<h3 class="yk-card__title"><a href="' + p.url + '">' + p.title + '</a></h3>' +
            '<div class="yk-card__row">' +
              '<span class="yk-card__price">' + moneyFmt(variant.price) + '</span>' +
              '<button type="button" class="yk-addbtn" data-add-to-cart data-variant-id="' + variant.id + '">Add</button>' +
            '</div>' +
          '</div>';
        grid.appendChild(card);
      });
    });
  }

  document.addEventListener('yk:wishlistchange', render);
  document.getElementById('yk-wish-addall').addEventListener('click', function () {
    document.querySelectorAll('#yk-wish-grid [data-add-to-cart]').forEach(function (btn) { btn.click(); });
  });
  render();
})();
</script>

{% schema %}{ "name": "Wishlist", "settings": [] }{% endschema %}
