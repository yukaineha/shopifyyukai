<section id="box" style="background:var(--cream);padding:100px 0">
  <div class="wrap yk-grid-2" style="display:grid;grid-template-columns:.85fr 1.15fr;gap:52px;align-items:start">
    <div class="rv">
      <div class="yk-kicker" style="color:var(--t)">{{ section.settings.kicker }}</div>
      <h2 class="yk-h2" style="margin-bottom:16px">{{ section.settings.heading }}</h2>
      <p style="font-size:16.5px;line-height:1.65;color:rgba(23,87,45,.7);max-width:400px;margin:0 0 20px">{{ section.settings.body }}</p>

      <div data-box-builder data-box-slots="{{ section.settings.slots }}" style="border:1.5px dashed rgba(23,87,45,.25);border-radius:20px;padding:22px;background:#fff">
        <div style="display:grid;grid-template-columns:repeat({{ section.settings.slots_per_row }},minmax(0,1fr));gap:8px;margin-bottom:18px">
          {%- for i in (1..section.settings.slots) -%}
            <div data-box-slot style="position:relative;aspect-ratio:3/4;border-radius:11px;overflow:hidden;background:#fff;border:1.5px dashed rgba(23,87,45,.24);transition:all .45s var(--ease)"></div>
          {%- endfor -%}
        </div>
        <div style="display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap">
          <div>
            <div data-box-count style="font-weight:700;font-size:14.5px">0 of {{ section.settings.slots }} chosen</div>
            <div style="font-size:12.5px;color:rgba(23,87,45,.6)">Fill the box, then add it to cart.</div>
          </div>
          <div style="display:flex;gap:8px;align-items:center">
            <button type="button" data-box-clear style="border:none;background:none;padding:10px 4px;font:600 11.5px/1 var(--font-body);letter-spacing:.06em;cursor:pointer;color:rgba(23,87,45,.55);text-decoration:underline">Clear</button>
            <button type="button" data-box-cta class="btn btn-primary btn-sm" disabled>Add box to cart</button>
          </div>
        </div>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px" class="yk-grid-3">
      {%- for product in section.settings.collection.products limit: 12 -%}
        {%- assign accent = '#17572D' -%}
        {%- if product.tags contains 'mil-baith-ke' -%}{%- assign accent = '#EEBF25' -%}
        {%- elsif product.tags contains 'mehmaan-nawazi' -%}{%- assign accent = '#19B1C1' -%}
        {%- elsif product.tags contains 'sehat-ki-baatein' -%}{%- assign accent = '#663988' -%}{%- endif -%}
        <button type="button" data-box-tile="{{ product.id }}" data-variant-id="{{ product.selected_or_first_available_variant.id }}" data-img="{{ product.featured_image | image_url: width: 200 }}" data-color="{{ accent }}cc" data-label="{{ product.title | escape }}"
          style="cursor:pointer;text-align:left;border:1.5px solid rgba(23,87,45,.1);background:#fff;border-radius:14px;padding:11px;display:flex;gap:10px;align-items:center;transition:all .35s;font-family:var(--font-body)">
          <div style="width:38px;height:48px;border-radius:7px;overflow:hidden;flex:none;background:{{ accent }}20">
            {%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 100 }}" alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block">{%- endif -%}
          </div>
          <div style="min-width:0">
            <div style="font-family:var(--font-heading);font-weight:800;font-size:15.5px;line-height:1.05;color:var(--ink)">{{ product.title }}</div>
            <div style="font-size:10.5px;color:rgba(23,87,45,.6);margin-top:3px">{{ product.metafields.custom.subtitle | default: product.type }}</div>
          </div>
        </button>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>[data-box-tile].is-picked{border-color:var(--g) !important;background:rgba(23,87,45,.06) !important}</style>

{% schema %}
{
  "name": "Build your box",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pick a box, fill it your way" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your own box" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Choose the jars. Zero arguments over who gets the makhana." },
    { "type": "collection", "id": "collection", "label": "Products to choose from" },
    { "type": "range", "id": "slots", "label": "Box slots", "min": 2, "max": 9, "step": 1, "default": 6 },
    { "type": "range", "id": "slots_per_row", "label": "Slots per row", "min": 2, "max": 6, "step": 1, "default": 6 }
  ],
  "presets": [{ "name": "Build your box" }]
}
{% endschema %}
