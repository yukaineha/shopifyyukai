<section style="padding:0 0 96px">
  <div class="wrap">
    <div class="rv" style="background:var(--y);border-radius:28px;padding:52px 44px;position:relative;overflow:hidden">
      <div style="position:absolute;width:320px;height:320px;border-radius:50%;background:var(--cream);opacity:.34;right:-70px;top:-90px;animation:drift 9s ease-in-out infinite"></div>
      <div style="position:relative;display:grid;grid-template-columns:1.1fr .9fr;gap:36px;align-items:center" class="yk-grid-2">
        <div>
          <div class="yk-kicker" style="color:var(--p)">{{ section.settings.kicker }}</div>
          <h2 style="font-size:clamp(34px,4.4vw,60px);margin:4px 0 11px">{{ section.settings.heading }}</h2>
          <p style="margin:0;font-size:15.5px;color:rgba(23,87,45,.8);max-width:420px">{{ section.settings.body }}</p>
        </div>
        {%- form 'customer', id: 'newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div style="display:flex;gap:10px;flex-wrap:wrap">
            <input type="email" name="contact[email]" required placeholder="you@email.com" style="flex:1;min-width:210px;border:none;border-radius:999px;padding:17px 22px;font:500 15px/1 var(--font-body);color:var(--ink);outline:none">
            <button type="submit" class="btn btn-primary">Sign me up</button>
          </div>
          {%- if form.posted_successfully? -%}
            <p style="margin:10px 0 0;font-size:13.5px;color:var(--g)">Thanks — you're on the list.</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "10% off your first jar" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the snack list" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "New flavours, festive boxes, and the odd recipe. One email a fortnight, never more." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
