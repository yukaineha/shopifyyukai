<header class="yk-header">
  <div class="yk-header__row wrap" style="padding-left:0;padding-right:0">
    <a href="{{ routes.root_url }}" class="yk-header__logo">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="112" height="56" style="height:56px;width:auto">
      {%- else -%}
        <span style="font-family:var(--font-heading);font-weight:800;font-size:24px">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="yk-nav">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </nav>

    <div class="yk-header__actions">
      <a href="{{ routes.account_url }}" class="yk-iconbtn" aria-label="Account">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="8" r="3.6"></circle><path d="M4.8 20c0-3.6 3.2-5.8 7.2-5.8s7.2 2.2 7.2 5.8"></path></svg>
      </a>
      <button class="yk-cartbtn" data-cart-open type="button">
        CART<span class="yk-cartbtn__count">{{ cart.item_count }}</span>
      </button>
      <button class="yk-navtoggle" data-nav-toggle type="button" aria-label="Menu">☰</button>
    </div>
  </div>
  <nav id="yk-mobile-nav" class="yk-mobilenav">
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {%- endfor -%}
    <a href="{{ routes.all_products_collection_url }}">Wishlist &amp; Account</a>
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu" }
  ]
}
{% endschema %}
