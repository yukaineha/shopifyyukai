<section style="padding:56px 0 40px;background:var(--cream)">
  <div class="wrap yk-grid-2" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:50px;align-items:center">
    <div>
      <div class="yk-breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><span style="font-weight:700;color:var(--ink)">Our story</span></div>
      <div class="yk-kicker" style="color:var(--o)">{{ section.settings.kicker }}</div>
      <h1 style="font-size:clamp(38px,5vw,68px);margin:6px 0 18px">{{ section.settings.heading }}</h1>
      <p style="font-size:17px;line-height:1.7;color:rgba(23,87,45,.8);margin:0;max-width:520px">{{ section.settings.body }}</p>
    </div>
    <div style="border-radius:24px;overflow:hidden;aspect-ratio:4/3">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="" style="width:100%;height:100%;object-fit:cover;display:block">
      {%- else -%}
        <img src="{{ 'founders.jpg' | asset_url }}" alt="YUKAI founders in the roasting kitchen" style="width:100%;height:100%;object-fit:cover;display:block">
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Roasted, never fried" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made in Ahmedabad, since day one" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "YUKAI started as a question in a family kitchen: why does every packaged snack in India assume oil is unavoidable. It isn't. Every jar we make since has been dry roasted, never fried." }
  ],
  "presets": [{ "name": "About hero" }]
}
{% endschema %}
