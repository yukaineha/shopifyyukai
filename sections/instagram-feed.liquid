<section style="padding:0 0 100px">
  <div class="wrap">
    <div class="rv" style="display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:20px;flex-wrap:wrap">
      <div style="display:flex;align-items:baseline;gap:14px;flex-wrap:wrap">
        <h2 style="font-size:clamp(30px,3.8vw,56px)">{{ section.settings.handle }}</h2>
        <span class="yk-kicker" style="font-size:23px;color:var(--o)">tag us, we repost</span>
      </div>
      <a href="{{ section.settings.url }}" target="_blank" rel="noopener" class="btn btn-primary btn-sm">
        Follow on Instagram
      </a>
    </div>
    <div style="display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px" class="yk-grid-4">
      {%- assign fallback_tiles = 'moment-cardnight.jpg,occasion-gifting.jpg,moment-guests.jpg,occasion-office.jpg,moment-morning.jpg,occasion-travel.jpg' | split: ',' -%}
      {%- for block in section.blocks -%}
        <a href="{{ section.settings.url }}" target="_blank" rel="noopener" style="display:block;position:relative;aspect-ratio:1;border-radius:13px;overflow:hidden;background:var(--cream)">
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 500 }}" alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block">
          {%- elsif fallback_tiles[forloop.index0] -%}
            <img src="{{ fallback_tiles[forloop.index0] | asset_url }}" alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block">
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
    <p style="font-size:12px;color:rgba(23,87,45,.5);margin:12px 0 0">Live feed: connect the Instagram app in Shopify to this handle and these tiles fill with your latest posts automatically.</p>
  </div>
</section>

{% schema %}
{
  "name": "Instagram feed",
  "settings": [
    { "type": "text", "id": "handle", "label": "Handle", "default": "@yukaifoodroots" },
    { "type": "url", "id": "url", "label": "Instagram URL" }
  ],
  "blocks": [
    { "type": "tile", "name": "Tile", "settings": [{ "type": "image_picker", "id": "image", "label": "Image" }] }
  ],
  "default": {
    "blocks": [
      { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }
    ]
  },
  "presets": [{ "name": "Instagram feed" }]
}
{% endschema %}
