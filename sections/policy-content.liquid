<section style="padding:44px 0 60px">
  <div class="wrap" style="max-width:760px;margin:0 auto">
    <div class="yk-breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><span style="font-weight:700;color:var(--ink)">{{ section.settings.heading }}</span></div>
    <h1 style="font-size:clamp(32px,4vw,52px);margin-bottom:8px">{{ section.settings.heading }}</h1>
    <p style="font-size:13.5px;color:rgba(23,87,45,.55);margin:0 0 30px">{{ section.settings.updated }}</p>
    <div class="yk-prose">{{ section.settings.body }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Policy content",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "updated", "label": "Last updated line" },
    { "type": "richtext", "id": "body", "label": "Body" }
  ],
  "presets": [{ "name": "Policy content" }]
}
{% endschema %}
