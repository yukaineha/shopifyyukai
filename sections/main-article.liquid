<article style="padding:40px 0 60px">
  <div class="wrap" style="max-width:800px">
    <div class="yk-breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><a href="{{ blog.url }}">{{ blog.title }}</a><span>/</span><span style="font-weight:700;color:var(--ink)">{{ article.title }}</span></div>
    <div style="font-size:10.5px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--o);margin-bottom:12px">{{ article.tags.first | default: "Journal" }}</div>
    <h1 style="font-size:clamp(34px,4.6vw,58px);margin-bottom:14px;line-height:1.05">{{ article.title }}</h1>
    <div style="font-size:13px;color:rgba(23,87,45,.55);margin-bottom:30px">{{ article.author }} · {{ article.published_at | date: "%d %B %Y" }}</div>
    {%- if article.image -%}
      <div style="border-radius:22px;overflow:hidden;aspect-ratio:16/9;margin-bottom:34px">
        <img src="{{ article.image | image_url: width: 1400 }}" alt="{{ article.title | escape }}" style="width:100%;height:100%;object-fit:cover;display:block">
      </div>
    {%- endif -%}
    <div class="yk-prose" style="font-size:17px;line-height:1.8">{{ article.content }}</div>

    {%- if blog.comments_enabled? -%}
      <div style="margin-top:50px;padding-top:30px;border-top:1px solid rgba(23,87,45,.12)">
        <h2 style="font-size:24px;margin-bottom:20px">Comments</h2>
        {%- for comment in article.comments -%}
          <div style="padding:16px 0;border-bottom:1px solid rgba(23,87,45,.08)">
            <div style="font-weight:700;font-size:14px">{{ comment.author }}</div>
            <div style="font-size:14px;color:rgba(23,87,45,.75);margin-top:4px">{{ comment.content }}</div>
          </div>
        {%- endfor -%}
        {%- form 'new_comment', article -%}
          {%- if form.posted_successfully? -%}<p style="color:var(--g)">Thanks — your comment is in.</p>{%- endif -%}
          <input type="text" name="comment[author]" placeholder="Name" required style="width:100%;margin-bottom:10px;border:1.5px solid rgba(23,87,45,.16);border-radius:12px;padding:12px 16px">
          <input type="email" name="comment[email]" placeholder="Email" required style="width:100%;margin-bottom:10px;border:1.5px solid rgba(23,87,45,.16);border-radius:12px;padding:12px 16px">
          <textarea name="comment[body]" placeholder="Comment" required rows="4" style="width:100%;margin-bottom:10px;border:1.5px solid rgba(23,87,45,.16);border-radius:12px;padding:12px 16px"></textarea>
          <button type="submit" class="btn btn-primary">Post comment</button>
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
</article>

{% schema %}{ "name": "Article", "settings": [] }{% endschema %}
