<section style="padding:100px 0">
  <div class="wrap">
    <div class="rv" style="margin-bottom:34px">
      <h2 class="yk-h2">{{ section.settings.heading }}</h2>
    </div>
    <div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px" class="yk-grid-4">
      {%- for block in section.blocks -%}
        <div class="rv" style="position:relative;overflow:hidden;display:flex;flex-direction:column;border-radius:20px;border:1.5px solid rgba(23,87,45,.12);background:#fff;padding:26px 24px">
          <div style="position:relative;display:flex;align-items:center;justify-content:space-between;gap:10px">
            <div style="color:var(--y);font-size:13px;letter-spacing:.2em">★★★★★</div>
            <div style="font-family:var(--font-heading);font-weight:800;font-size:34px;line-height:1;color:{{ block.settings.color }};opacity:.35">”</div>
          </div>
          <p style="position:relative;font-size:16.5px;line-height:1.55;margin:13px 0 20px;flex:1">{{ block.settings.quote }}</p>
          <div style="position:relative;display:flex;align-items:center;gap:11px">
            <div style="width:34px;height:34px;border-radius:50%;background:{{ block.settings.color }};color:#FFFAF3;display:flex;align-items:center;justify-content:center;font:700 13px/1 var(--font-body);flex:none">{{ block.settings.who | slice: 0 }}</div>
            <div style="min-width:0">
              <div style="font-weight:700;font-size:13.5px">{{ block.settings.who }}</div>
              <div style="font-size:12px;color:rgba(23,87,45,.6)">{{ block.settings.city }} · bought {{ block.settings.bought }}</div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "What the shelf says" }],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "textarea", "id": "quote", "label": "Quote" },
      { "type": "text", "id": "who", "label": "Name" },
      { "type": "text", "id": "city", "label": "City" },
      { "type": "text", "id": "bought", "label": "Product bought" },
      { "type": "color", "id": "color", "label": "Avatar color", "default": "#EEBF25" }
    ]}
  ],
  "default": {
    "blocks": [
      { "type": "review", "settings": { "quote": "Fiery Pop is my go-to for games night. Refilled the bowl three times, then ordered two more jars.", "who": "Ananya R.", "city": "Mumbai", "bought": "Fiery Pop", "color": "#EEBF25" } },
      { "type": "review", "settings": { "quote": "The edamame actually tastes of masala, not just salt. It has replaced my 4pm biscuit habit.", "who": "Karthik S.", "city": "Bengaluru", "bought": "Desi Kick", "color": "#663988" } },
      { "type": "review", "settings": { "quote": "Fruit Burst goes into my daughter's tiffin every second day. No sugar, no arguments.", "who": "Meera J.", "city": "Ahmedabad", "bought": "Fruit Burst", "color": "#17572D" } },
      { "type": "review", "settings": { "quote": "Sent twelve hampers to clients for Diwali. Three of them asked where to buy more.", "who": "Rohit B.", "city": "Delhi", "bought": "Kappa box", "color": "#19B1C1" } }
    ]
  },
  "presets": [{ "name": "Testimonials" }]
}
{% endschema %}
