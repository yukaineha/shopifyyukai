<section style="padding:100px 0">
  <div class="wrap yk-grid-2" style="max-width:1300px;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:50px;align-items:center">
    <div class="rv" style="border-radius:22px;overflow:hidden;aspect-ratio:4/3">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block">
      {%- else -%}
        <img src="{{ 'founders.jpg' | asset_url }}" alt="The YUKAI founders behind a table of jars" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block">
      {%- endif -%}
    </div>
    <div class="rv">
      <div class="yk-kicker" style="color:var(--o)">{{ section.settings.kicker }}</div>
      <h2 style="font-size:clamp(36px,4.6vw,64px);margin:4px 0 20px">{{ section.settings.heading }}</h2>
      {%- for block in section.blocks -%}
        {%- if block.type == 'paragraph' -%}
          <p style="font-size:17.5px;line-height:1.7;color:rgba(23,87,45,.8);margin:0 0 14px">{{ block.settings.text }}</p>
        {%- endif -%}
      {%- endfor -%}
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:28px;margin-top:12px">
        {%- for block in section.blocks -%}
          {%- if block.type == 'person' -%}
            <div style="border:1.5px solid rgba(23,87,45,.13);border-radius:16px;padding:15px 18px">
              <div style="font-family:var(--font-heading);font-weight:800;font-size:21px;letter-spacing:-.02em">{{ block.settings.role }}</div>
              <div style="font-size:12px;color:rgba(23,87,45,.6);margin-top:3px">{{ block.settings.name }}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div style="display:flex;gap:40px;flex-wrap:wrap">
        {%- for block in section.blocks -%}
          {%- if block.type == 'stat' -%}
            <div>
              <div style="font-family:var(--font-heading);font-weight:800;font-size:46px;line-height:1;color:var(--p)">{{ block.settings.value }}</div>
              <div style="font-size:11.5px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:rgba(23,87,45,.6);margin-top:5px">{{ block.settings.label }}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Founders story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "How it started" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A roasting drum and one stubborn rule" }
  ],
  "blocks": [
    { "type": "paragraph", "name": "Paragraph", "settings": [{ "type": "textarea", "id": "text", "label": "Text" }] },
    { "type": "person", "name": "Person", "settings": [
      { "type": "text", "id": "role", "label": "Role" },
      { "type": "text", "id": "name", "label": "Name" }
    ]},
    { "type": "stat", "name": "Stat", "settings": [
      { "type": "text", "id": "value", "label": "Value" },
      { "type": "text", "id": "label", "label": "Label" }
    ]}
  ],
  "default": {
    "blocks": [
      { "type": "paragraph", "settings": { "text": "YUKAI started because the good stuff in Indian kitchens, makhana, roasted chana and dry fruits, kept arriving in plain bags with nothing to say for itself. We took the drum, the masalas we grew up on, and one rule: roast it, never fry it." } },
      { "type": "paragraph", "settings": { "text": "Seventeen flavours later, the rule hasn't moved." } },
      { "type": "person", "settings": { "role": "Founder", "name": "Prateek Bansal" } },
      { "type": "person", "settings": { "role": "Founder", "name": "Swapnil Bansal" } },
      { "type": "person", "settings": { "role": "Mentor", "name": "Kailash Bansal" } },
      { "type": "stat", "settings": { "value": "17", "label": "flavours" } },
      { "type": "stat", "settings": { "value": "0", "label": "palm oil" } },
      { "type": "stat", "settings": { "value": "1.2k", "label": "reviews" } }
    ]
  },
  "presets": [{ "name": "Founders story" }]
}
{% endschema %}
